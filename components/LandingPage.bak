import React, { useState, useEffect } from "react";
import { supabase } from "../supabase/client";
import { Toaster, toast } from "react-hot-toast";

// --- REUSABLE COMPONENTS ---

// Modal Component
const InfoModal = ({ title, onClose, children }: any) => (
  <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fade-in">
    <div className="bg-white w-full max-w-2xl rounded-lg shadow-2xl border-t-8 border-blue-900 relative flex flex-col max-h-[90vh]">
      <div className="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50">
        <h3 className="text-xl font-black text-slate-800 uppercase tracking-tight">
          {title}
        </h3>
        <button
          onClick={onClose}
          className="text-slate-400 hover:text-red-700 transition-colors"
        >
          <span className="material-symbols-outlined">close</span>
        </button>
      </div>
      <div className="p-8 overflow-y-auto font-sans text-slate-600 leading-relaxed text-sm">
        {children}
      </div>
      <div className="p-4 border-t border-slate-100 bg-slate-50 flex justify-end">
        <button
          onClick={onClose}
          className="px-6 py-2 bg-slate-800 text-white font-bold uppercase text-xs rounded hover:bg-slate-900 transition-colors"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>
);

// Card Component (Paper Style)
const PaperCard = ({
  children,
  className = "",
}: {
  children: React.ReactNode;
  className?: string;
}) => (
  <div
    className={`relative bg-white border border-slate-200 shadow-xl rounded-sm ${className}`}
  >
    {children}
  </div>
);

// --- HEADER ---
const Header = () => {
  const scrollToLogin = () => {
    document
      .getElementById("login-section")
      ?.scrollIntoView({ behavior: "smooth" });
  };

  return (
    <nav className="fixed top-0 left-0 right-0 z-50 bg-[#0f172a]/90 backdrop-blur-md border-b border-white/10 h-20 flex items-center px-6 md:px-12 justify-between transition-all shadow-lg">
      <div className="w-24 hidden md:block"></div>
      <div className="flex flex-col items-center">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 bg-blue-900 rounded flex items-center justify-center shadow-lg border border-white/10">
            <span className="text-white font-black text-xl drop-shadow-md">
              S
            </span>
          </div>
          <span className="font-black text-white text-2xl tracking-tight leading-none drop-shadow-md">
            SASE
          </span>
        </div>
        <span className="text-[10px] text-blue-200 font-bold tracking-[0.2em] uppercase mt-1">
          CONECTAMOS CONTIGO
        </span>
      </div>
      <button
        onClick={scrollToLogin}
        className="hidden md:block w-24 text-right text-xs font-bold text-white hover:text-blue-200 uppercase tracking-wide transition-colors"
      >
        Acceso
      </button>
    </nav>
  );
};

// --- LOGIN FORM SECTION ---
const SectionLogin = ({
  onRegisterClick,
}: {
  onRegisterClick?: () => void;
}) => {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [modalOpen, setModalOpen] = useState<"MANUAL" | "PRIVACY" | null>(null);

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setError(null);
    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });
    if (error) {
      setError("Credenciales incorrectas.");
      setLoading(false);
    }
  };

  return (
    <section
      id="login-section"
      className="min-h-screen flex items-center justify-center relative bg-[#0f172a] px-6 py-24 border-t border-slate-800"
    >
      {modalOpen === "MANUAL" && (
        <InfoModal
          title="Manual de Operación SASE"
          onClose={() => setModalOpen(null)}
        >
          <div className="space-y-6">
            <div className="bg-blue-50 p-4 border-l-4 border-blue-800 text-blue-900 font-bold text-sm">
              Acceso restringido a personal autorizado.
            </div>
            <p>
              El Sistema de Administración y Seguimiento Escolar (SASE) es la
              plataforma oficial para la gestión institucional.
            </p>
            <ul className="list-disc ml-5 space-y-1">
              <li>
                <strong>Docentes:</strong> Listas de asistencia digital y
                reportes de conducta.
              </li>
              <li>
                <strong>Prefectura:</strong> Gestión de rondas y disciplina.
              </li>
              <li>
                <strong>Dirección:</strong> Tableros de control y toma de
                decisiones.
              </li>
            </ul>
          </div>
        </InfoModal>
      )}
      {modalOpen === "PRIVACY" && (
        <InfoModal
          title="Aviso de Privacidad"
          onClose={() => setModalOpen(null)}
        >
          <p>
            La información contenida en este sistema es confidencial y propiedad
            de la Institución Educativa. El uso indebido de las credenciales de
            acceso será sancionado conforme al reglamento interno.
          </p>
        </InfoModal>
      )}

      <div className="max-w-4xl w-full grid md:grid-cols-2 gap-12 items-center z-10">
        {/* Left Column: Text */}
        <div className="space-y-6 order-2 md:order-1">
          <h2 className="text-4xl font-black text-white leading-tight">
            Plataforma <br />
            <span className="text-blue-400">Institucional</span>
          </h2>
          <p className="text-slate-400 text-lg font-light leading-relaxed">
            SASE centraliza la operación escolar para que usted pueda enfocarse
            en lo importante:
            <strong className="text-white font-bold ml-1">la educación.</strong>
          </p>

          <div className="flex flex-col gap-3 pt-4">
            <button
              onClick={() => setModalOpen("MANUAL")}
              className="text-left text-xs font-bold text-slate-500 hover:text-white uppercase tracking-widest transition-colors flex items-center gap-2"
            >
              <span className="material-symbols-outlined text-sm">
                menu_book
              </span>{" "}
              Manual de Usuario
            </button>
            <button
              onClick={() => setModalOpen("PRIVACY")}
              className="text-left text-xs font-bold text-slate-500 hover:text-white uppercase tracking-widest transition-colors flex items-center gap-2"
            >
              <span className="material-symbols-outlined text-sm">
                security
              </span>{" "}
              Política de Datos
            </button>
          </div>
        </div>

        {/* Right Column: Login Card */}
        <div className="order-1 md:order-2">
          <PaperCard className="p-8 md:p-10 border-t-4 border-t-orange-500">
            <div className="text-center mb-8">
              <h3 className="text-xl font-black text-slate-800 uppercase tracking-widest">
                Bienvenido
              </h3>
              <div className="w-16 h-1 bg-slate-100 mx-auto mt-4 rounded-full"></div>
            </div>

            <form onSubmit={handleLogin} className="space-y-6">
              {error && (
                <div className="bg-red-50 text-red-800 p-3 text-xs font-bold border-l-4 border-red-600 animate-pulse">
                  {error}
                </div>
              )}

              <div className="space-y-2">
                <label className="text-[10px] font-black text-slate-500 uppercase tracking-widest">
                  Credencial de Usuario
                </label>
                <div className="relative">
                  <input
                    type="email"
                    required
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-slate-900 font-bold text-sm outline-none focus:border-blue-600 focus:bg-white transition-all pl-10"
                    placeholder="usuario@sase.edu.mx"
                  />
                  <span className="material-symbols-outlined absolute left-3 top-3 text-slate-400 text-[20px]">
                    person
                  </span>
                </div>
              </div>

              <div className="space-y-2">
                <label className="text-[10px] font-black text-slate-500 uppercase tracking-widest">
                  Contraseña de Acceso
                </label>
                <div className="relative">
                  <input
                    type="password"
                    required
                    value={password}
                    onChange={(e) => setPassword(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-slate-900 font-bold text-sm outline-none focus:border-blue-600 focus:bg-white transition-all pl-10"
                    placeholder="••••••••"
                  />
                  <span className="material-symbols-outlined absolute left-3 top-3 text-slate-400 text-[20px]">
                    lock
                  </span>
                </div>
              </div>

              <button
                disabled={loading}
                className="w-full bg-orange-600 hover:bg-orange-700 text-white font-bold py-4 rounded-lg shadow-lg shadow-orange-900/20 active:scale-[0.98] transition-all uppercase text-xs tracking-widest flex items-center justify-center gap-2"
              >
                {loading ? "Verificando..." : "Ingresar al Sistema"}
                {!loading && (
                  <span className="material-symbols-outlined text-sm">
                    arrow_forward
                  </span>
                )}
              </button>
            </form>

            <div className="mt-8 text-center border-t border-slate-100 pt-6">
              <button
                onClick={onRegisterClick}
                className="text-[10px] font-black text-slate-400 hover:text-blue-600 uppercase tracking-widest transition-colors"
              >
                Solicitar Registro Administrativo
              </button>
            </div>
          </PaperCard>
        </div>
      </div>
    </section>
  );
};

// --- CINEMATIC INTRO DATA ---
const situationalCards = [
  {
    title: "PREFECTURA",
    body: "3 alumnos caminando en pasillos sin pase de salida.",
    urgent: true,
    bg: "bg-white",
    angle: "-rotate-3",
    pos: "top-[15%] left-[10%]",
  },
  {
    title: "ORIENTACIÓN",
    body: "Padre de familia solicita cita urgente (Caso 3B).",
    urgent: true,
    bg: "bg-white",
    angle: "rotate-6",
    pos: "top-[40%] right-[15%]",
  },
  {
    title: "DOCENCIA",
    body: "Sin formato de reporte para incidencia en aula.",
    urgent: false,
    bg: "bg-slate-50",
    angle: "-rotate-6",
    pos: "bottom-[30%] left-[20%]",
  },
  {
    title: "DIRECCIÓN",
    body: "Faltan estadísticas de asistencia del mes actual.",
    urgent: true,
    bg: "bg-white",
    angle: "rotate-2",
    pos: "top-[25%] left-[45%]",
  },
  {
    title: "CONTROL ESCOLAR",
    body: "Expediente incompleto: Alumno nuevo ingreso.",
    urgent: false,
    bg: "bg-slate-50",
    angle: "rotate-12",
    pos: "bottom-[15%] right-[10%]",
  },
];

// --- MAIN LANDING (NARRATIVE WRAPPER) ---
export const LandingPage: React.FC<any> = (props) => {
  const [scrollY, setScrollY] = useState(0);
  const [windowHeight, setWindowHeight] = useState(1000);

  useEffect(() => {
    // robust window check
    setWindowHeight(window.innerHeight);
    const handleScroll = () =>
      requestAnimationFrame(() => setScrollY(window.scrollY));
    const handleResize = () => setWindowHeight(window.innerHeight);

    window.addEventListener("scroll", handleScroll);
    window.addEventListener("resize", handleResize);
    return () => {
      window.removeEventListener("scroll", handleScroll);
      window.removeEventListener("resize", handleResize);
    };
  }, []);

  const totalScrollHeight = windowHeight * 2; // Reduced slightly for snap
  const progress = Math.min(Math.max(scrollY / totalScrollHeight, 0), 1);

  // ACT 1: CHAOS (0 -> 0.4)
  // Cards scatter outwards as we scroll
  const chaosFactor = progress * 2000;

  // ACT 2: HUMAN QUESTION (0.4 -> 0.7)
  const questionOpacity =
    progress > 0.35 && progress < 0.8
      ? Math.min(1, Math.sin((progress - 0.35) * Math.PI * 3)) // sharp sine
      : 0;

  // ACT 3: ORDER (0.7 -> 1.0)
  const logoOpacity = Math.max(0, (progress - 0.75) * 4);
  const sceneScale = 1 + progress * 0.5;

  return (
    <div className="bg-[#0f172a] text-slate-200 font-sans min-h-screen overflow-x-hidden selection:bg-blue-900 selection:text-white">
      <style>{`
         .hide-scrollbar::-webkit-scrollbar { display: none; }
         .paper-shadow { box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.3); }
      `}</style>
      <Toaster position="top-right" />
      <Header />

      {/* --- CINEMATIC NARRATIVE STAGE --- */}
      <div className="relative h-[250vh]">
        <div className="sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center perspective-1000">
          {/* AMBIENT BACKGROUND */}
          <div className="absolute inset-0 bg-gradient-to-b from-[#0f172a] to-[#1e293b] -z-20"></div>

          {/* ACT 1: FLOATING PAPERS (School Chaos) */}
          <div
            className="absolute inset-0 w-full h-full pointer-events-none"
            style={{ opacity: 1 - progress * 2.5 }}
          >
            {situationalCards.map((card, i) => {
              // Calculate scatter direction based on index to ensure spread
              const dirX = i % 2 === 0 ? 1 : -1;
              const dirY = i < 2 ? -1 : 1;

              return (
                <div
                  key={i}
                  className={`absolute ${card.pos} transition-transform duration-75 ease-linear w-64 md:w-80`}
                  style={{
                    transform: `translate(${chaosFactor * dirX * (0.5 + i * 0.1)}px, ${chaosFactor * dirY * (0.5 + i * 0.1)}px) ${card.angle} scale(${sceneScale})`,
                    zIndex: 10 - i,
                  }}
                >
                  <div
                    className={`${card.bg} p-6 paper-shadow transform hover:scale-105 transition-transform duration-500`}
                  >
                    <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-2">
                      <span className="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                        {card.title}
                      </span>
                      {card.urgent && (
                        <div className="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>
                      )}
                    </div>
                    <p className="text-slate-800 font-bold font-serif text-lg leading-snug">
                      "{card.body}"
                    </p>
                    <div className="mt-4 flex gap-2">
                      <div className="h-1 w-8 bg-slate-200 rounded-full"></div>
                      <div className="h-1 w-4 bg-slate-200 rounded-full"></div>
                    </div>
                  </div>
                </div>
              );
            })}

            {/* Title for Act 1 */}
            <div
              className="absolute bottom-20 left-0 right-0 text-center"
              style={{ transform: `translateY(${progress * -200}px)` }}
            >
              <p className="text-slate-500 font-bold uppercase tracking-[0.4em] text-xs mb-2 animate-bounce">
                Desliza para conectar
              </p>
            </div>
          </div>

          {/* ACT 2: THE QUESTION (Human Pause) */}
          <div
            className="absolute inset-0 flex items-center justify-center p-8 text-center transition-opacity"
            style={{
              opacity: questionOpacity,
              transform: `scale(${0.9 + questionOpacity * 0.1})`,
            }}
          >
            <h2 className="text-2xl md:text-5xl font-light text-white leading-tight max-w-4xl">
              ¿Cuánta energía pierdes tratando de <br />
              <span className="font-bold text-blue-400">
                organizar el caos?
              </span>
            </h2>
          </div>

          {/* ACT 3: SASE REVEAL (Order) */}
          <div
            className="absolute inset-0 flex flex-col items-center justify-center text-center p-8 transition-opacity"
            style={{ opacity: logoOpacity }}
          >
            <div className="relative mb-8">
              <div className="absolute inset-0 bg-blue-500 blur-[100px] opacity-20"></div>
              <div className="relative w-28 h-28 bg-gradient-to-t from-blue-900 to-blue-800 rounded-sm flex items-center justify-center shadow-2xl border border-white/10">
                <span className="text-white font-black text-6xl drop-shadow-lg">
                  S
                </span>
              </div>
            </div>

            <h1 className="text-7xl md:text-9xl font-black text-white tracking-tighter mb-4 drop-shadow-2xl">
              SASE
            </h1>

            <div className="flex items-center gap-4 mb-12">
              <div className="h-[1px] w-12 bg-blue-500/50"></div>
              <p className="text-blue-200 font-bold uppercase tracking-[0.3em] text-sm md:text-base">
                Conectamos Contigo
              </p>
              <div className="h-[1px] w-12 bg-blue-500/50"></div>
            </div>

            <div className="animate-bounce mt-10">
              <span className="material-symbols-outlined text-slate-500 text-3xl">
                keyboard_double_arrow_down
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* FINAL LANDING CONTENT */}
      <div className="relative z-20">
        <SectionLogin {...props} />
      </div>
    </div>
  );
};

export default LandingPage;

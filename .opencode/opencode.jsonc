{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "TestSprite": {
      "type": "local",
      "enabled": true,
      "command": ["bash", ".opencode/bin/testsprite-mcp.sh"]
    },
    "Stitch": {
      "type": "local",
      "enabled": true,
      "command": ["bash", ".opencode/bin/stitch-mcp.sh"]
    },
    "Supabase": {
      "type": "local",
      "enabled": true,
      "command": ["bash", ".opencode/bin/supabase-mcp.sh"]
    },
    "NotebookLM": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@m4ykeldev/notebooklm-mcp@latest", "serve"]
    },
    "Figma": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "figma-dev-mode-mcp-server"]
    }
  }
}

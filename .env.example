# ============================================================
# SASE-310 - Configuración de Variables de Entorno
# Copia este archivo a .env.local y completa los valores
# ============================================================

# ---- FRONTEND (Vite) ----
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ---- SERVER / API (Vercel) ----
# URL del proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave privilegiada para operaciones server-side (NUNCA en frontend)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Anon key alternativa para server-side (opcional)
SUPABASE_ANON_KEY=tu-anon-key
# Orígenes permitidos separados por coma (sin espacios)
ALLOWED_ORIGINS=https://tu-dominio.com,http://localhost:3100
# ---- IA ----
OPENROUTER_API_KEY=sk-or-v1-tu-key
GOOGLE_API_KEY=tu-gemini-key
# ---- WhatsApp Business API ----
WHATSAPP_TOKEN=tu-whatsapp-token
WHATSAPP_PHONE_ID=tu-phone-number-id
# ---- Rate Limiting (Upstash Redis o Vercel KV) ----
UPSTASH_REDIS_REST_URL=https://tu-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-upstash-token
KV_REST_API_URL=https://tu-kv.vercel-storage.com/kv
KV_REST_API_TOKEN=tu-kv-token
# ---- Módulos Institucionales ----
SASE_SHARED_SECRET=clave-secreta-compartida-feria
FERIA_APP_URL=http://localhost:3100/panel
FERIA_STUDENT_SESSION_TTL_SECONDS=7200
FERIA_SCAN_POINTS=0
FERIA_TRIVIA_POINTS=10
DIAGNOSTICO_APP_URL=http://localhost:3100/diagnostico
MATE_APP_URL=http://localhost:3100/mate
# ---- Scripts de Testing y Smoke ----
TEST_DOCENTE_EMAIL=docente.smoke@sase.mx
TEST_DOCENTE_PASSWORD=CambiaEstaClave123!
TEST_BLOQUEADO_EMAIL=bloqueado.smoke@sase.mx
TEST_BLOQUEADO_PASSWORD=CambiaEstaClave123!
# ---- Scripts de Piloto ----
SASE_PROJECT_URL=https://tu-proyecto.supabase.co
SASE_SECRET_KEY=tu-service-role-key
SASE_PUBLISHABLE_KEY=tu-publishable-key
